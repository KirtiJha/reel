{
  "name": "@kirtijha/reel",
  "version": "0.1.0",
  "description": "Demos-as-code for web apps and CLIs. A small YAML spec drives your real app and renders always-current GIF, MP4, storyboards and a self-contained interactive click-through — and fails your build when the flow breaks.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/KirtiJha/reel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirtiJha/reel.git"
  },
  "bugs": {
    "url": "https://github.com/KirtiJha/reel/issues"
  },
  "bin": {
    "reel": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "//prepublishOnly": "dist/ is git-ignored, so a publish from a fresh clone would otherwise ship an empty package. Building and testing here makes that impossible.",
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "reel": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "example": "tsx src/cli.ts record examples/taskflow/demo.reel.yaml",
    "test:author": "tsx scripts/author-selftest.ts",
    "test:player": "tsx scripts/player-selftest.ts",
    "test:branch": "tsx scripts/branch-selftest.ts",
    "ui": "tsx src/cli.ts ui",
    "studio:install": "npm --prefix studio install",
    "schema": "tsx scripts/gen-schema.ts",
    "test:capture": "tsx scripts/capture-selftest.ts"
  },
  "keywords": [
    "demo",
    "demos-as-code",
    "product-demo",
    "interactive-demo",
    "demo-automation",
    "gif",
    "mp4",
    "screencast",
    "screen-recording",
    "screenshot",
    "storyboard",
    "playwright",
    "cli",
    "terminal",
    "readme",
    "documentation",
    "docs-as-code",
    "developer-tools",
    "devtools",
    "automation",
    "ci",
    "testing",
    "typescript"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "ffmpeg-static": "^5.2.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.48.0",
    "sharp": "^0.33.5",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ajv": "^8.20.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
