{
  "name": "reel",
  "version": "0.1.0",
  "description": "Open-source demos-as-code for web apps. Describe it or script it; Reel drives your real app and renders a polished, always-current demo — and fails your build when the flow breaks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reel": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "reel": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "example": "tsx src/cli.ts record examples/taskflow/demo.reel.yaml",
    "test:author": "tsx scripts/author-selftest.ts",
    "ui": "tsx src/cli.ts ui",
    "studio:install": "npm --prefix studio install"
  },
  "keywords": [
    "demo",
    "gif",
    "screenshot",
    "playwright",
    "readme",
    "documentation",
    "screencast",
    "as-code",
    "ci"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "ffmpeg-static": "^5.2.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.48.0",
    "sharp": "^0.33.5",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
