# Reel AI authoring (`reel author`) — model access via a LiteLLM proxy.
#
# Reel is provider-agnostic: it talks to your LiteLLM proxy over its
# OpenAI-compatible endpoint, and the proxy routes to whatever model you
# configure (Claude, Gemini, GPT, …). Bring your own key.

LITELLM_API_BASE=https://your-litellm-proxy.example.com   # base is normalized to /v1
LITELLM_API_KEY=sk-your-litellm-key
LITELLM_MODEL=your-model-name                             # a leading provider/ prefix is stripped
                                                          # e.g. litellm_proxy/vertex-ai-gemini-3-flash

# TLS: set to false for corporate proxies whose certificates don't verify
# locally (mirrors the GridFlow SSL_VERIFY handling). Defaults to true.
SSL_VERIFY=false

# Optional tuning (safe to omit):
# LITELLM_REASONING_EFFORT=low     # sent as reasoning_effort; dropped automatically if unsupported
# LITELLM_TEMPERATURE=0.2

# OPENAI_API_BASE / OPENAI_API_KEY are accepted as fallbacks for the two above.
