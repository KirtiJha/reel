# Reel AI authoring (`reel author`) — model access.
#
# Reel is provider-agnostic. Point it at any provider with an OpenAI-compatible
# endpoint, at Anthropic's native API, or at a model running on your own
# machine. Only `reel author` and subtitle translation need a model at all —
# record, check and heal work offline.
#
# Pick a provider and set its key. Everything else has a sensible default.

REEL_LLM_PROVIDER=openai
REEL_LLM_API_KEY=sk-your-key
REEL_LLM_MODEL=gpt-4o

# --- Providers -------------------------------------------------------------
#
#   openai      OpenAI                    key: OPENAI_API_KEY
#   anthropic   Anthropic (native API)    key: ANTHROPIC_API_KEY
#   gemini      Google Gemini             key: GEMINI_API_KEY
#   azure       Azure OpenAI              key: AZURE_OPENAI_API_KEY  (set REEL_LLM_BASE_URL)
#   litellm     LiteLLM proxy             key: LITELLM_API_KEY       (set REEL_LLM_BASE_URL)
#   openrouter  OpenRouter                key: OPENROUTER_API_KEY
#   groq        Groq                      key: GROQ_API_KEY
#   mistral     Mistral                   key: MISTRAL_API_KEY
#   deepseek    DeepSeek                  key: DEEPSEEK_API_KEY
#   together    Together AI               key: TOGETHER_API_KEY
#   xai         xAI                       key: XAI_API_KEY
#   ollama      Ollama, local             no key needed
#   lmstudio    LM Studio, local          no key needed
#   custom      Any other OpenAI-compatible endpoint (set REEL_LLM_BASE_URL)
#
# Each provider also reads its own conventional key variable, so if you already
# export OPENAI_API_KEY or ANTHROPIC_API_KEY, naming the provider is enough.

# --- Examples --------------------------------------------------------------
#
# Anthropic:
#   REEL_LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   REEL_LLM_MODEL=claude-sonnet-4-5
#
# A model on your own machine, no key, no network:
#   REEL_LLM_PROVIDER=ollama
#   REEL_LLM_MODEL=llama3.1
#
# LiteLLM or any other proxy:
#   REEL_LLM_PROVIDER=litellm
#   REEL_LLM_BASE_URL=https://your-proxy.example.com   # normalized to /v1
#   LITELLM_API_KEY=sk-your-litellm-key
#   REEL_LLM_MODEL=litellm_proxy/vertex-ai-gemini-3-flash   # a routing prefix is stripped
#
# Azure OpenAI (the base URL includes your deployment):
#   REEL_LLM_PROVIDER=azure
#   REEL_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
#   AZURE_OPENAI_API_KEY=...

# --- Optional --------------------------------------------------------------

# TLS: set to false for corporate proxies whose certificates don't verify
# locally. Defaults to true.
# SSL_VERIFY=false

# REEL_LLM_TEMPERATURE=0.2
# REEL_LLM_REASONING_EFFORT=low   # dropped automatically if the model rejects it

# The previous LITELLM_* / OPENAI_* variables still work unchanged — an
# existing setup needs no edits.
