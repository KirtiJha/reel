node_modules/
dist/
*.log
.DS_Store
.reel-cache/
.reel-out/
coverage/
*.tsbuildinfo
.env
.env.local
scripts/out/
scripts/authored.reel.yaml
examples/*/out/
demos/out/
# Planning notes kept alongside the code but not published with it: the
# positioning, competitive read and roadmap are working documents, not docs.
/demosascodeproductplan*.md

# Renders written by a spec's `output:` paths when run from the repo root
# (hero.reel.yaml, aangan.reel.yaml). The copies the site ships are committed
# under studio/public/demo/ instead — see docs/deploy-site.md.
/out/

# Diagnostics from a failed step — local, never committed.
.reel-failures/

# Render fingerprint, written beside a spec's outputs.
.reel-stamp.json

# Before/after strips from `reel diff` — a review aid, not an artifact.
.reel-diff/

# Saved sign-ins. A Playwright storage state holds live session cookies — a
# bearer credential, not config — so committing one signs everybody in as you.
# `reel capture --save-auth` writes these, and warns when git can still see them.
.auth/
*.storagestate.json
storage-state*.json
auth.json
*-auth.json
